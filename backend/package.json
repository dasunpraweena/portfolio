{
  "name": "dasun-portfolio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:inspect": "node scripts/database.js inspect",
    "db:migrate": "node scripts/database.js migrate",
    "db:seed": "node scripts/database.js seed",
    "storage:check": "node scripts/storage.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@electric-sql/pglite": "0.4.3"
  }
}
