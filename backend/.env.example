# Copy to .env. Enter real values only in that local file, never in chat.
NODE_ENV=development
PORT=3001
# Supabase Connect > Session pooler, IPv4, port 5432. Percent-encode the password.
# Replace PROJECT_REF, REGION, and ENCODED_PASSWORD with your own values.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=portfolio&sslmode=require&sslaccept=strict"
# Optional: omit when migrations use the same Session pooler URL.
# MIGRATION_DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=portfolio&sslmode=require&sslaccept=strict"
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_LOCALLY
# Supabase Auth user UUID(s), separated by commas. No roles from request bodies.
ADMIN_USER_IDS=REPLACE_WITH_YOUR_AUTH_USER_UUID
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_ORIGINS=http://localhost:5174
PUBLIC_BUCKET=portfolio-public
PRIVATE_BUCKET=portfolio-private
# Both buckets must have Public bucket switched OFF. Express controls downloads.
TRUST_PROXY_HOPS=0
# Set to the exact project ref only AFTER running db:inspect and reviewing its output.
DB_TARGET_CONFIRMED=
# Set true only if db:inspect lists existing unrelated application tables you reviewed.
DB_EXISTING_TABLES_REVIEWED=false
# Optional local path to a trusted Supabase CA certificate if your system needs it.
# DATABASE_SSL_CA_FILE=C:/path/to/supabase-ca.crt
